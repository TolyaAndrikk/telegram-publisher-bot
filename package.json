{
  "name": "telegram-publisher-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "dev:worker": "tsx watch src/workers/delivery.worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "start:web": "node dist/app.js",
    "start:worker": "node dist/workers/delivery.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "webhook:set": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.26.0",
    "grammy": "^1.21.0",
    "ioredis": "^5.3.0",
    "luxon": "^3.4.0",
    "pg": "^8.11.0",
    "pino": "^8.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/luxon": "^3.4.0",
    "prisma": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
